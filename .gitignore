# Root rules only. client/ and server/ each have their own .gitignore.

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies (in case anything is installed at the root)
node_modules/
vendor/

# Logs and local databases
*.log
*.sqlite
*.sqlite3

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
