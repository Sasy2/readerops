# Copy to .env and fill in. Never commit .env
APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=readerops
DB_USER=readerops_app
DB_PASS=

# Used to sign sessions. Generate with: openssl rand -hex 32
APP_KEY=

# SMS is stubbed for the course build. Messages are logged, not sent.
SMS_DRIVER=log
SMS_API_KEY=
