# Copy to .env.local and fill in. Never commit .env.local
# Vite only exposes variables prefixed with VITE_ to the browser (import.meta.env.VITE_*)
VITE_API_URL=http://localhost:8000

# Supabase cloud project (Project Settings > API). Anon key only — never the service role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
